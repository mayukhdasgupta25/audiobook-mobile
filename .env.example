# Environment configuration
# =========================
#
# This app supports four build environments:
#   development | testing | staging | production
#
# Each environment has a committed template file:
#   .env.development   — local dev (Srota Dev, com.srota.mobile.dev)
#   .env.testing       — internal QA (Srota Test, com.srota.mobile.test)
#   .env.staging       — pre-prod (Srota Staging, com.srota.mobile.staging)
#   .env.production    — store release (Srota, com.srota.mobile)
#
# Usage:
#   npm run start:development     # Metro with .env.development
#   npm run run:android:staging   # Native build with staging config
#
# Override locally (gitignored):
#   .env.local   — overrides any env file (secrets, LAN IP, etc.)
#   .env         — legacy single-file override
#
# Set APP_ENV via npm scripts or manually:
#   cross-env APP_ENV=staging npm run start:staging
#
# Physical device on LAN: set your machine IP in .env.local, e.g.:
#   EXPO_PUBLIC_AUTH_API_URL=http://192.168.1.100
#   EXPO_PUBLIC_API_URL=http://192.168.1.100
#   EXPO_PUBLIC_STREAMING_URL=http://192.168.1.100
#
# Platform defaults when URLs are empty:
#   Android emulator → 10.0.2.2:{port}
#   iOS simulator / web → localhost:{port}
#
# Ports (development defaults):
#   Auth API:      8080
#   Main app API:  8081
#   Streaming API: 8082

APP_ENV=development
EXPO_PUBLIC_APP_ENV=development

EXPO_PUBLIC_AUTH_API_URL=
EXPO_PUBLIC_AUTH_API_PORT=8080
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_PORT=8081
EXPO_PUBLIC_STREAMING_URL=
EXPO_PUBLIC_STREAMING_URL_PORT=8082
EXPO_PUBLIC_API_V1_PATH=/api/v1
EXPO_PUBLIC_API_V1_STREAM_PATH=/api/v1/stream

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
