# Staging environment — pre-production validation
APP_ENV=staging
EXPO_PUBLIC_APP_ENV=staging

EXPO_PUBLIC_AUTH_API_URL=https://auth-staging.example.com
EXPO_PUBLIC_AUTH_API_PORT=443
