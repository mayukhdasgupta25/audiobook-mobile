# Production environment — store releases
APP_ENV=production
EXPO_PUBLIC_APP_ENV=production

EXPO_PUBLIC_AUTH_API_URL=https://auth.example.com
EXPO_PUBLIC_AUTH_API_PORT=443
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_API_PORT=443
EXPO_PUBLIC_STREAMING_URL=https://stream.example.com
EXPO_PUBLIC_STREAMING_URL_PORT=443

EXPO_PUBLIC_API_V1_PATH=/api/v1
EXPO_PUBLIC_API_V1_STREAM_PATH=/api/v1/stream

# Set via EAS Secrets for cloud builds — leave empty in repo
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
